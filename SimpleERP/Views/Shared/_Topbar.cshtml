<header class="app-topbar">
    <button class="app-topbar__menu-button"
            type="button"
            id="sidebarToggle"
            aria-label="Abrir menu"
            aria-controls="appSidebar"
            aria-expanded="false">
        <svg aria-hidden="true"
             viewBox="0 0 24 24"
             width="20"
             height="20">
            <path d="M4 6h16M4 12h16M4 18h16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round" />
        </svg>
    </button>

    <div class="app-topbar__actions">
        <button class="app-topbar__icon-button"
        type="button"
        id="themeToggle"
        aria-label="Ativar modo escuro"
        title="Ativar modo escuro"
        aria-pressed="false">
    <svg id="themeIconSun" aria-hidden="true" viewBox="0 0 24 24"
         width="20" height="20" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
    </svg>

    <svg id="themeIconMoon" aria-hidden="true" viewBox="0 0 24 24"
         width="20" height="20" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         hidden>
        <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.463.402.807a6.5 6.5 0 0 0 8.268 8.268c.344-.215.829-.003.803.397"></path>
    </svg>
</button>
    <button class="app-topbar__icon-button"
            type="button"
            aria-label="Pesquisar"
            title="Pesquisar">
        <svg aria-hidden="true" viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.34-4.34"></path>
        </svg>
    </button>

    <button class="app-topbar__icon-button"
            type="button"
            aria-label="Notificações"
            title="Notificações">
        <svg aria-hidden="true" viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        >
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
            <path d="M10 21h4"></path>
        </svg>
    </button>

    <button class="app-topbar__icon-button"
            type="button"
            aria-label="Perfil"
            title="Perfil">
        <svg aria-hidden="true" viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
            <circle cx="12" cy="8" r="5"></circle>
            <path d="M20 21a8 8 0 0 0-16 0"></path>
        </svg>
    </button>
</div>
    
    <h1 class="app-topbar__title">
        @(ViewData["Title"] ?? "SimpleERP")
    </h1>
</header>