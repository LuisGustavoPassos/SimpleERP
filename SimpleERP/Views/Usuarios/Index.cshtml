@model IEnumerable<SimpleERP.ViewModels.UsuarioViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Tabela de usuários</h1>  


    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
        <a class="btn btn-primary" role="button"  class="btn btn-primary" asp-action="Create">Criar Novo</a>
    </div>

        
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nome)
                </td>
                <td>
                    <div class="btn-group" role="group" aria-label="example">
                    <a role="button" class="btn btn-primary"  asp-action="Edit" asp-route-id="@item.Id">Edit</a> 
                    <a role="button" class="btn btn-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a> 
                    <a role="button" class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
